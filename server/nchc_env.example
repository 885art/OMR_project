# Copy this file outside Git as nchc_env.sh and replace the example paths.
# Do not put passwords, API keys, or account tokens in this file.

export PYTHON=/path/to/conda/envs/omr25/bin/python
export YOLOV9_ROOT=/path/to/WongKinYiu/yolov9
export DEEPSCORES_ROOT=/fast/scratch/$USER/ds2_complete
export WORK_ROOT=/fast/scratch/$USER/omr_experiments
export PRETRAINED_WEIGHTS=/fast/scratch/$USER/weights/yolov9-s.pt
export YOLO11_WEIGHTS=/fast/scratch/$USER/weights/yolo11n.pt

# Generated by server/prepare_symbols_v2.sh.
export DATASET_ROOT=$WORK_ROOT/datasets/symbols_tiny_v2

# Training defaults. Override these after checking available GPU memory.
export DEVICE=0
export WORKERS=8
export BATCH_SIZE=-1
export VAL_BATCH_SIZE=16
export USE_IMAGE_WEIGHTS=0
